# --- Required ---
# Bot token from https://discord.com/developers/applications
TOKEN=your-discord-bot-token

# Your Discord user ID (enables owner-only commands like purge, rr, reboot, update)
OWNER=your-discord-user-id

# --- Optional: GIF command ---
# Tenor v2 API key from Google Cloud (the old Tenor v1 keys no longer work)
TENORKEY=your-tenor-v2-api-key
