# --- Required ---
# Bot token from https://discord.com/developers/applications
TOKEN=your-discord-bot-token

# Your Discord user ID (enables owner-only commands like purge, rr, reboot, update)
OWNER=your-discord-user-id

# --- Optional: AI commands ---
# OpenAI API key (!gpt)
GPT=your-openai-api-key

# Google Gemini API key (!gemini) — older .env files may call this BARD
GEMINI_API_KEY=your-google-gemini-api-key

# Ollama endpoint and model (!ollama). Defaults: http://127.0.0.1:11434/api/generate, dolphin-mixtral
OLLAMAAPI=http://127.0.0.1:11434/api/generate
OLLAMAMODEL=dolphin-mixtral

# --- Optional: GIF command ---
# Tenor v2 API key from Google Cloud (the old Tenor v1 keys no longer work)
TENORKEY=your-tenor-v2-api-key
