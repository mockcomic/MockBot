# --- Required ---
# Bot token from https://discord.com/developers/applications
TOKEN=your-discord-bot-token

# Your Discord user ID. Enables owner-only commands (feedbacklist, reboot,
# update) and lets you control playback without sitting in the same voice channel.
OWNER=your-discord-user-id

# --- Optional ---
# Where the bot keeps its runtime state (feedback log, reaction-role menu ids,
# saved playlists, reminders, per-guild settings, portal overrides, usage
# counters, audit log).
# Default: ./data next to the bot. Point it somewhere outside the git working
# tree if you prefer, e.g. /var/lib/mockbot
# MOCKBOT_DATA_DIR=./data

# Optional Genius access token for the `lyrics` command. Not required — the
# command works without one; a token only reduces rate-limit friction.
# https://genius.com/settings/developers/apps
# GENIUS_TOKEN=

# Live-stream announcements (`watch add`). Both are optional; without them the
# matching platform's watch entries are refused at add time.
# Twitch: create an app at https://dev.twitch.tv/console/apps
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# YouTube: a free Data API v3 key from https://console.cloud.google.com
# GOOGLE_API_KEY=

# Web admin portal (status, servers, command toggles, settings, feedback,
# audit). The portal starts only when WEB_USER is set plus one of
# WEB_PASS / WEB_PASS_HASH / WEB_USERS below.
# It binds to every interface by default, so anyone on the local network can
# reach it and the login is the access control; set WEB_BIND=127.0.0.1 to keep
# it to this machine only, or WEB_ALLOWLIST to hard-gate addresses.
# dotenv reads a bare '#' as a comment — quote any value containing one,
# and restart the bot after editing .env (it is only read at boot).
# WEB_USER=admin
# WEB_PASS="choose-a-long-password"
# WEB_PORT=8787
# WEB_BIND=0.0.0.0

# Prefer no plaintext password in .env? Store the sha256 hex digest instead
# (print one with: node -e "console.log(require('crypto').createHash('sha256').update('your password').digest('hex'))")
# WEB_PASS_HASH=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Multiple named accounts (audit log then shows WHO changed what), each with
# a sha256 hex digest: user:hash,user2:hash2
# WEB_USERS=mockcomic:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef,other:feedface...

# Hard address gate: comma-separated allowed IP prefixes (empty = any address
# that can route to the port). e.g. only localhost and the LAN block:
# WEB_ALLOWLIST=127.,::1,192.168.0.

# HTTPS directly from the bot (self-signed or LetsEncrypt files):
# WEB_TLS_CERT=/etc/ssl/certs/mockbot.pem
# WEB_TLS_KEY=/etc/ssl/private/mockbot.key
# Behind a TLS-terminating proxy instead, mark the cookie Secure anyway:
# WEB_SECURE=1
